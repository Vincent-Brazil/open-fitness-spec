{
  "title": "Open Fitness cycling exchange 0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/zones"
    },
    {
      "$ref": "#/$defs/details"
    },
    {
      "$ref": "#/$defs/ftp_test"
    },
    {
      "$ref": "#/$defs/recording"
    }
  ],
  "$defs": {
    "zones": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "entered",
            "derived"
          ]
        },
        "bands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "min_bpm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 299
              },
              "max_bpm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              }
            },
            "required": [
              "label",
              "min_bpm",
              "max_bpm"
            ]
          }
        }
      },
      "required": [
        "source",
        "bands"
      ]
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "course_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "kind": {
          "enum": [
            "workout",
            "route",
            "game",
            "other"
          ]
        },
        "completion": {
          "enum": [
            "completed",
            "stopped_early"
          ]
        },
        "timer_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "elapsed_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "cadence_rpm": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "avg_hr_bpm": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "work_kj": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "ftp_w": {
          "type": "number",
          "minimum": 1,
          "maximum": 2500
        },
        "power_source": {
          "enum": ["measured", "estimated", "unknown"],
          "description": "How this recorder obtained the watts used for its average power, normalised power and best efforts. Omission means unknown."
        },
        "power_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "best_watts": {
          "type": "object",
          "maxProperties": 32,
          "patternProperties": {
            "^[1-9][0-9]{0,5}$": {
              "type": "number",
              "minimum": 0,
              "maximum": 20000
            }
          },
          "additionalProperties": false
        },
        "achievements": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "weight_kg": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2499
        },
        "weight_source": {
          "enum": [
            "entered",
            "passport",
            "measured",
            "saved_setting"
          ]
        },
        "normalized_power_w": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "training_load": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "estimated": {
              "type": "boolean"
            }
          },
          "required": [
            "method",
            "score",
            "estimated"
          ]
        },
        "power_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "min_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "max_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              },
              "seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 604800
              }
            },
            "required": [
              "label",
              "min_pct",
              "max_pct",
              "seconds"
            ]
          },
          "maxItems": 20
        },
        "ascent_source": {
          "enum": ["saved_route_profile"],
          "description": "The source reconstructed ascent from its saved route elevations and ridden distance."
        },
        "ascent_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "dependentRequired": { "ascent_source": ["ascent_m"] },
      "required": []
    },
    "ftp_test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2499
        },
        "method": {
          "enum": [
            "ramp",
            "20min",
            "field_test",
            "lab_test"
          ]
        },
        "effective_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 45
        },
        "source_ride_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "watts",
        "method",
        "effective_at",
        "source_ride_id",
        "expected_revision"
      ]
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock": {
          "enum": [
            "timer",
            "elapsed"
          ]
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "power_w",
              "cadence_rpm",
              "speed_kph",
              "hr_bpm",
              "lat",
              "lon",
              "altitude_m",
              "distance_m"
            ]
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "maxItems": 9
          },
          "maxItems": 86401
        },
        "laps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "start_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 604800
              },
              "end_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 604800
              }
            },
            "required": [
              "label",
              "start_s",
              "end_s"
            ]
          },
          "maxItems": 2500
        }
      },
      "required": [
        "clock",
        "channels",
        "samples",
        "laps"
      ]
    }
  }
}
